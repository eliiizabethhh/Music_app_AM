<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RegisterActivity">

    <ImageView
        android:id="@+id/imgFondo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/fondo_login"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/contenedor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_margin="30dp"
        app:cardElevation="35dp"
        app:cardCornerRadius="25dp"
        android:backgroundTint="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registro de Usuario"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#F64A8A"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="30dp"/>

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Nombre"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#E4007C"
                android:textColorHint="#F64A8A"
                android:inputType="textEmailAddress"
                android:drawablePadding="10dp"
                android:layout_marginBottom="15dp"
                android:drawableStart="@drawable/twotone_account_box_24"/>

            <EditText
                android:id="@+id/etCorreo"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Correo electrónico"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#E4007C"
                android:textColorHint="#F64A8A"
                android:inputType="textEmailAddress"
                android:drawablePadding="10dp"
                android:drawableStart="@drawable/baseline_email_24"/>



            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_input"
                android:hint="Contraseña"
                android:paddingStart="20dp"
                android:paddingEnd="15dp"
                android:textColor="#E4007C"
                android:textColorHint="#F64A8A"
                android:inputType="textPassword"
                android:drawablePadding="10dp"
                android:layout_marginTop="15dp"
                android:drawableStart="@drawable/outline_admin_panel_settings_24"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@drawable/bg_button"
                android:layout_marginTop="25dp"
                android:text="REGISTRAR"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15dp"/>



        </LinearLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>