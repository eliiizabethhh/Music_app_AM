<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101818"
    android:padding="24dp"
    tools:context=".HomeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101818"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MUSIC DISCOVERY"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora tus géneros favoritos"
                android:textColor="#AABBBB"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="25dp"/>

            <!-- POP -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="POP"
                android:textColor="#E53935"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/imgPop"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_margin="12dp"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/tvPop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando álbumes..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="25dp" />

            <!-- ROCK -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ROCK"
                android:textColor="#E53935"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/imgRock"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_margin="12dp"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/tvRock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando álbumes..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="25dp"/>

            <!-- REGGAETON -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REGGAETÓN"
                android:textColor="#E53935"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/imgReggaeton"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_margin="12dp"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/tvReggaeton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cargando álbumes..."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="25dp"/>


        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>